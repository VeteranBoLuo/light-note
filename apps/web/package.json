{
  "name": "web",
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "deploy": "bash deploy.sh",
    "dev": "vite",
    "build": "pnpm run check:drawing-thumbnail-renderer && tsc --noEmit --skipLibCheck && rimraf dist && vite build && node scripts/ensure-spa-route-fallbacks.mjs && node scripts/prerender.mjs && node scripts/verify-seo-artifacts.mjs",
    "build:extension": "vite build --config vite.extension.config.ts",
    "package:extension": "pnpm run build:extension && node scripts/package-extension.mjs",
    "check:drawing-thumbnail-renderer": "node scripts/drawing-thumbnail-renderer-contract.mjs",
    "preview": "vite preview",
    "preview:build": "pnpm run check:drawing-thumbnail-renderer && tsc --noEmit --skipLibCheck && rimraf dist && vite build && vite preview",
    "preview:local": "VITE_ENV=production PRERENDER_API_ORIGIN=http://127.0.0.1:9001 PRERENDER_API_STRIP_PREFIX=1 pnpm run build && VITE_ENV=local vite preview --host 127.0.0.1 --port 4173 --strictPort --open",
    "prettier:comment": "自动格式化当前目录下的所有文件",
    "prettier": "prettier --write",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@antv/g6": "^5.1.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@lezer/markdown": "^1.7.2",
    "@lightnote/shared": "workspace:*",
    "@tinymce/tinymce-vue": "^6.3.0",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/excel": "^1.7.14",
    "@vue-office/pptx": "^1.0.1",
    "ant-design-vue": "^4.0.8",
    "axios": "^1.18.0",
    "cheerio": "^1.0.0",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.11",
    "dompurify": "^3.4.13",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lodash-es": "^4.17.21",
    "marked": "^17.0.1",
    "mermaid": "^11.16.1",
    "pdfjs-dist": "4.9.155",
    "pinia": "^2.1.7",
    "prismjs": "^1.30.0",
    "tinymce": "8.6.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "^5.7.2",
    "vue": "^3.4.15",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "9",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@iconify/vue": "^4.1.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.13.10",
    "@types/chrome": "0.2.7",
    "@types/vue": "^2.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "dotenv": "^16.4.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "less": "^4.9.0",
    "prettier": "^3.1.1",
    "playwright-core": "1.57.0",
    "rimraf": "^6.0.1",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^6.4.3",
    "vite-plugin-cdn-import": "^0.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.2.6",
    "vue-tsc": "^2.2.12"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "@vue/typescript/recommended",
      "plugin:prettier/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2020
    },
    "rules": {
      "vue/multi-word-component-names": 0,
      "quotes": 0,
      "semi": 0,
      "trailing-comma": 0,
      "vue/html-self-closing": 0,
      "prettier/prettier": 0
    }
  }
}
