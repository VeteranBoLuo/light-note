# 本地开发必须连接本地数据库；远程数据库默认由适配器拒绝。
NODE_ENV=development
LIGHTNOTE_RUNTIME_ENV=local
ALLOW_REMOTE_DATABASE_WRITES=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tag_db

# 社区聊天室保持失败关闭；完成 Schema 迁移和前后端发布后，再按顺序开启消息、投票、已读回执与实时能力。
COMMUNITY_CHAT_ACCESS_MODE=closed
COMMUNITY_CHAT_MESSAGING_ENABLED=false
COMMUNITY_CHAT_FILES_ENABLED=false
COMMUNITY_CHAT_POLLS_ENABLED=false
COMMUNITY_CHAT_READ_RECEIPTS_ENABLED=false
COMMUNITY_CHAT_REALTIME_ENABLED=false
COMMUNITY_CHAT_EMERGENCY_READ_ONLY=false

# 轻笺浏览器插件网站授权白名单。逗号分隔 32 位 Chrome/Edge 扩展 ID；留空时授权接口失败关闭。
LIGHTNOTE_EXTENSION_IDS=nkdlhmfjnokoicodeepadkamopdblbnd

# 积分经济按 C3 → C4 → C5 逐级启用。执行对应迁移并通过 Schema 门禁后再开启下一版。
POINTS_ECONOMY_C4_ENABLED=true
POINTS_ECONOMY_C5_ENABLED=false
# C6 继承 C5 限购；开启前确认既有 C4/C5 migration 已完成。
POINTS_ECONOMY_C6_ENABLED=false
POINTS_ECONOMY_C7_ENABLED=false
POINTS_ECONOMY_C8_ENABLED=false
# C9：个人背景永久兑换（先完成个人背景 Schema 与帮助迁移）。
POINTS_ECONOMY_C9_ENABLED=false
# C10：仅收紧免费惊喜，先同步对应帮助内容，保留 C9 供关闭后回退。
POINTS_ECONOMY_C10_ENABLED=false
POINTS_ECONOMY_REQUIRE_WRITE_VERSION=true
POINTS_SHOP_PURCHASE_ENABLED=true
POINTS_LOTTERY_FREE_ENABLED=true
POINTS_LOTTERY_PAID_ENABLED=true

# 爱发电资源商店按“发放处理器 → 目录 → 结算 → 活动”顺序启用；首次部署保持关闭。
SUPPORT_PACKAGES_GRANT_ENABLED=false
SUPPORT_PACKAGES_CATALOG_ENABLED=false
SUPPORT_PACKAGES_CHECKOUT_ENABLED=false
SUPPORT_CAMPAIGNS_ENABLED=false
# 通用动态网页读取兜底：静态 HTML 无内容或触发环境验证时，使用一次性低权限 Chromium。
# 生产环境默认启用；机器必须安装 Chrome/Chromium。后端以 root 运行时子进程会默认降权到 65534。
WEB_PAGE_RENDERER_ENABLED=true
# WEB_PAGE_RENDERER_EXECUTABLE_PATH=/usr/bin/chromium
WEB_PAGE_RENDERER_UID=65534
WEB_PAGE_RENDERER_GID=65534
WEB_PAGE_RENDERER_CONCURRENCY=1
WEB_PAGE_RENDERER_QUEUE_LIMIT=6
WEB_PAGE_RENDERER_QUEUE_TIMEOUT_MS=5000

# One-process, explicitly authorized remote inspection only. Never enable both access overrides.
ALLOW_REMOTE_DATABASE_READS=false

# Browser push (opt-in per browser). Generate a persistent VAPID pair once; never log private keys.
BROWSER_PUSH_ENABLED=false
BROWSER_PUSH_ORIGIN=
BROWSER_PUSH_VAPID_PUBLIC_KEY=
BROWSER_PUSH_VAPID_PRIVATE_KEY=
BROWSER_PUSH_VAPID_SUBJECT=
# Optional FCM relays, in priority order (max 2); each requires url and token. Never commit real tokens.
BROWSER_PUSH_RELAYS=[]

# Optional dedicated GitHub OAuth relay. Set both values; leave both empty for direct GitHub access.
# URL must be HTTPS with the /github path. Use a separate secret from browser push; never commit real values.
GITHUB_OAUTH_RELAY_URL=
GITHUB_OAUTH_RELAY_TOKEN=

# Managed card previews: never fall back to original images. Enable cleanup only after a complete reference backfill.
IMAGE_PREVIEW_GENERATION_ENABLED=true
IMAGE_PREVIEW_NOTES_ENABLED=true
IMAGE_PREVIEW_CLOUD_ENABLED=true
IMAGE_PREVIEW_CLEANUP_ENABLED=false

# 公开收集匿名去重：独立随机密钥（至少 32 字符）；留空时仅允许多次提交模式。
# 多实例使用同一密钥；切勿在每次启动时重新生成。
COLLECTION_FORMS_IDENTITY_SECRET=

# 纯文本社区帖子 AI 审核：显式迁移后开放；关闭时转人工，不扣作者额度。
COMMUNITY_AI_REVIEW_ENABLED=false
COMMUNITY_AI_REVIEW_DAILY_BUDGET_TOKENS=300000

# 站内公开资源：显式迁移后逐项启用；始终由管理员终审，AI 不扣作者额度。
PUBLIC_RESOURCES_ENABLED=false
PUBLIC_RESOURCES_SUBMISSIONS_ENABLED=false
PUBLIC_RESOURCES_AI_ENABLED=false
PUBLIC_RESOURCES_AI_DAILY_BUDGET_TOKENS=300000

# 知识庄园：显式安装庄园加法结构后开启总开关，积分沿用 user_growth.points。
# 开放范围 internal 仅 Root 与 test 账号，all 为全部登录账号；游客与管理员代管始终不可进入。
KNOWLEDGE_MANOR_ENABLED=false
KNOWLEDGE_MANOR_AUDIENCE=internal

# Huawei Android/卓易通 push: production only; notification-center messages use their actual category.
# API and existing browserPushWorker must share these values. Never embed the app secret in APK/Web.
HUAWEI_PUSH_ENABLED=false
HUAWEI_PUSH_ORIGIN=
HUAWEI_PUSH_APP_ID=
HUAWEI_PUSH_PROJECT_ID=
HUAWEI_PUSH_APP_SECRET=

# Comma-separated categories actually approved in Huawei console; never claim unapproved rights.
HUAWEI_PUSH_APPROVED_CATEGORIES=
# 普通系统/运营通知显式使用 MARKETING；只有实际获批的业务类别才能发送 WORK/SUBSCRIPTION。
# 回执需先部署接收入口，再在 AGC 的应用级回执配置中选择 V2、开启鉴权。
HUAWEI_PUSH_RECEIPTS_ENABLED=false
HUAWEI_PUSH_PACKAGE_NAME=top.boluo66.lightnote
HUAWEI_PUSH_RECEIPT_USERNAME=
# 新建回执配置的密钥为 Base64 编码；这里只填写服务端配置，不进入 Web/APK。
HUAWEI_PUSH_RECEIPT_SECRET=
# 使用 AGC 默认回执时可留空；多回执配置可填写指定 ID。
HUAWEI_PUSH_RECEIPT_ID=

# C8 获取策略：先停写并完成 preparePointsEarningC8.js --apply，再配置未来完整日/周边界。
# 依赖既有 C5 迁移与总闸；关闭 C8 只暂停发奖，不撤销已固化的周期版本。
# 成就目录随配置立即切换，每日/每周任务等待各自边界。
POINTS_EARNING_C8_ENABLED=false
POINTS_EARNING_C8_EFFECTIVE_DAY=
POINTS_EARNING_C8_EFFECTIVE_WEEK=
