# 本地开发必须连接本地数据库；远程数据库默认由适配器拒绝。
NODE_ENV=development
LIGHTNOTE_RUNTIME_ENV=local
ALLOW_REMOTE_DATABASE_WRITES=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tag_db

# 社区聊天室保持失败关闭；完成 Schema 迁移和前后端发布后，再按顺序开启消息、投票、已读回执与实时能力。
COMMUNITY_CHAT_ACCESS_MODE=closed
COMMUNITY_CHAT_MESSAGING_ENABLED=false
COMMUNITY_CHAT_POLLS_ENABLED=false
COMMUNITY_CHAT_READ_RECEIPTS_ENABLED=false
COMMUNITY_CHAT_REALTIME_ENABLED=false
COMMUNITY_CHAT_EMERGENCY_READ_ONLY=false

# 积分经济按 C3 → C4 → C5 逐级启用。执行对应迁移并通过 Schema 门禁后再开启下一版。
POINTS_ECONOMY_C4_ENABLED=true
POINTS_ECONOMY_C5_ENABLED=false
POINTS_ECONOMY_REQUIRE_WRITE_VERSION=true
POINTS_SHOP_PURCHASE_ENABLED=true
POINTS_LOTTERY_FREE_ENABLED=true
POINTS_LOTTERY_PAID_ENABLED=true

# 爱发电资源商店按“发放处理器 → 目录 → 结算 → 活动”顺序启用；首次部署保持关闭。
SUPPORT_PACKAGES_GRANT_ENABLED=false
SUPPORT_PACKAGES_CATALOG_ENABLED=false
SUPPORT_PACKAGES_CHECKOUT_ENABLED=false
SUPPORT_CAMPAIGNS_ENABLED=false
