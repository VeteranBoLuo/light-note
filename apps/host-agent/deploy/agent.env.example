# 这里只允许 Host Agent 自身的非敏感运行配置；不要加载 apps/server/.env。
HOST_AGENT_SOCKET_PATH=/run/lightnote-host-agent/agent.sock
HOST_AGENT_STATE_DIR=/var/lib/lightnote-host-agent/jobs
HOST_AGENT_PM2_BIN=/usr/bin/pm2
# 安装时替换 <agent-user>，必须与该账户实际 PM2_HOME 完全一致。
HOST_AGENT_PM2_HOME=/home/<agent-user>/.pm2
# direct：与非 root PM2 同账户；helper：兼容当前 root PM2，仅通过 root-owned 固定 helper；disabled：关闭 PM2 能力。
HOST_AGENT_PM2_ACCESS_MODE=direct
HOST_AGENT_SAMPLE_INTERVAL_MS=10000
HOST_AGENT_HISTORY_MINUTES=60
HOST_AGENT_PRIVILEGED_HELPER=/usr/local/libexec/lightnote-host-helper
