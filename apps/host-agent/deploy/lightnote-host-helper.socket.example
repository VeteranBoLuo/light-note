[Unit]
Description=Light Note privileged host helper socket
Before=lightnote-host-agent@.service

[Socket]
ListenStream=/run/lightnote-host-helper.sock
SocketUser=root
SocketGroup=<agent-user>
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true
Accept=true
MaxConnections=16

[Install]
WantedBy=sockets.target
