            android:fillColor="#FF8A84FA"
            android:pathData="M132,24h48c28.72,0 52,23.28 52,52v48h-48l-52,-52z" />
        <group
            android:pivotX="128"
            android:pivotY="128"
            android:rotation="90">
            <path
                android:fillColor="#FF817AF7"
                android:pathData="M132,24h48c28.72,0 52,23.28 52,52v48h-48l-52,-52z" />
        </group>
        <group
            android:pivotX="128"
            android:pivotY="128"
            android:rotation="180">
            <path
                android:fillColor="#FF5148D4"
                android:pathData="M132,24h48c28.72,0 52,23.28 52,52v48h-48l-52,-52z" />
        </group>
        <group
            android:pivotX="128"
            android:pivotY="128"
            android:rotation="270">
            <path
                android:fillColor="#FFAAA6FD"
                android:pathData="M132,24h48c28.72,0 52,23.28 52,52v48h-48l-52,-52z" />
        </group>
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M128,76L180,128L128,180L76,128Z" />
