<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LightNote" parent="Theme.LightNote.Base">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowSplashScreenBackground">@color/brand_primary</item>
        <!-- 系统开屏不使用带方形背景层的 adaptive icon，避免兼容层未裁切时露出方角。 -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">250</item>
    </style>
</resources>
