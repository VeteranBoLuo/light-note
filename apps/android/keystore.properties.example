# Copy this file to keystore.properties and keep the real file out of Git.
# Prefer an absolute path so the signing key remains outside the repository.
# On macOS, scripts/release-build.sh reads both passwords from the login
# Keychain. CI or other operating systems can provide the four
# LIGHT_NOTE_ANDROID_* environment variables instead.
storeFile=/absolute/secure/path/light-note-release.jks
keyAlias=light-note-release
