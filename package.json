{
  "name": "light-note",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "cookie@<0.7.0": "0.7.2",
      "exceljs>uuid": "11.1.1",
      "pdf-lib>tslib": "2.8.1",
      "esdk-obs-nodejs>fast-xml-parser": "5.7.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "ip-address@<10.7.4": "10.7.4",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "postcss@>=8.0.0 <8.5.23": "8.5.23",
      "undici@>=6.0.0 <6.29.1": "6.29.1",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "qs@<6.16.1": "6.16.1",
      "body-parser@>=1.0.0 <1.20.9": "1.20.9",
      "proxy-addr@<2.0.8": "2.0.8",
      "source-map-js@<1.2.2": "1.2.2",
      "browserslist@<4.28.7": "4.28.7",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.0",
      "katex@<0.18.2": "0.18.2"
    },
    "patchedDependencies": {
      "@vue-office/excel@1.7.14": "patches/@vue-office__excel@1.7.14.patch"
    }
  },
  "scripts": {
    "hooks:install": "node scripts/installGitHooks.mjs",
    "dev:web": "pnpm --filter web dev",
    "dev:web:device": "pnpm --filter web exec vite --host 0.0.0.0 --port 5175 --strictPort",
    "build:web": "pnpm --filter web build",
    "dev:server": "node scripts/localServer.mjs",
    "dev:server:watch": "node scripts/localServer.mjs --watch",
    "free:server-port": "node scripts/freePort.mjs 9001",
    "preview": "node scripts/localPreview.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter web typecheck",
    "deploy:all": "bash scripts/deploy.sh",
    "deploy:web": "bash scripts/deploy-web.sh",
    "deploy:server": "bash scripts/deploy-server.sh",
    "deploy:host-agent": "bash scripts/deploy-host-agent.sh"
  }
}
